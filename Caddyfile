# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Домен задаётся переменной SITE_DOMAIN в .env.
{$SITE_DOMAIN} {
	encode zstd gzip

	# Панель ходит внутри сети compose, наружу торчит только Caddy.
	reverse_proxy web:3000

	# Заголовки безопасности, которых нет в самом приложении.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
