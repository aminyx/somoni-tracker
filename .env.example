# ============================================================
#  Somoni Tracker — пример конфигурации.
#  Скопируйте в .env и заполните. Файл .env в git не попадает.
# ============================================================

# --- Telegram --------------------------------------------------------------
# Токен бота от @BotFather. Обязателен и для бота, и для проверки входа в панель.
TELEGRAM_BOT_TOKEN=сюда-токен-от-BotFather
# Username бота без @ — используется в ссылках вида t.me/<username>
TELEGRAM_BOT_USERNAME=SomoniTrackerBot

# --- Приложение ------------------------------------------------------------
# Публичный адрес панели. Бот подставляет его в кнопку «Открыть панель».
# Локально: http://localhost:3000
APP_URL=http://localhost:3000
PORT=3000

# Домен для автоматического HTTPS. Нужен только при развёртывании
# с docker-compose.caddy.yml на чистом сервере, где свободны порты 80 и 443.
# Своего домена нет — подойдёт бесплатное имя вида tracker.<ip-через-дефисы>.sslip.io
SITE_DOMAIN=

# Секрет для подписи сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-64-hex-chars

# --- База данных -----------------------------------------------------------
# Путь до файла SQLite. Каталог создаётся автоматически.
DATABASE_PATH=./data/tracker.db

# --- Локаль по умолчанию для новых пользователей ---------------------------
DEFAULT_TIMEZONE=Asia/Dushanbe
DEFAULT_CURRENCY=TJS

# --- Необязательное --------------------------------------------------------
# Курсы валют. Сервис отдаёт «сколько валюты за 1 сомони», приложение
# инвертирует это на входе. Если недоступен — берётся встроенная таблица.
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/TJS

# Распознавание сумм с фотографии чека. Работает офлайн: модели PaddleOCR
# (около 12 МБ) скачиваются при первом запуске и кэшируются. Ключи не нужны.
# Стоит около 300 МБ оперативной памяти — на маленьком сервере можно выключить.
ENABLE_RECEIPT_OCR=true

# Отдельный токен для локальной разработки. Telegram разрешает только ОДНОГО
# потребителя getUpdates на токен: если запустить бота локально с боевым
# токеном, бот на сервере замолчит. Заведите второго бота у @BotFather.
TELEGRAM_BOT_TOKEN_DEV=
