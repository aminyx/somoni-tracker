{
  "name": "somoni-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Трекер личных расходов в Telegram: бот для ввода одной строкой + веб-панель аналитики",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n web,bot -c cyan,magenta \"npm:dev:web\" \"npm:dev:bot\"",
    "dev:web": "next dev -p 3000",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "next build",
    "start": "next start",
    "bot": "tsx src/bot/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "next": "^16.3.4",
    "onnxruntime-node": "^1.29.0",
    "ppu-paddle-ocr": "^6.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
